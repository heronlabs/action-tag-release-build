{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "description": "Ignore linting/formatting tools pinned by gts convention",
      "enabled": false,
      "matchManagers": ["npm"],
      "matchPackageNames": ["eslint", "gts", "typescript", "typescript-eslint"],
      "matchPackagePrefixes": ["@eslint/"]
    },
    {
      "description": "Group all GitHub Actions updates together (no minimum release age — marketplace is curated)",
      "groupName": "github-actions dependencies",
      "matchManagers": ["github-actions"]
    },
    {
      "description": "Group all npm updates with 1-day minimum release age for supply chain safety",
      "groupName": "npm dependencies",
      "matchManagers": ["npm"],
      "minimumReleaseAge": "1 day"
    }
  ],
  "rangeStrategy": "pin",
  "timezone": "America/Sao_Paulo"
}
