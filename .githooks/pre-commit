#!/usr/bin/env bash
set -euo pipefail

# Only run when source-affecting files are staged
git diff --cached --quiet -- src/ package.json pnpm-lock.yaml tsconfig*.json && exit 0

pnpm build >/dev/null

git diff --quiet -- bin/src/index.js || {
  echo "bin/ stale: run 'pnpm build' and stage bin/src/index.js{,.map}" >&2
  exit 1
}
