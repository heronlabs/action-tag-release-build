#!/usr/bin/env bash

set -euo pipefail

QUEUE_FILE="${GH_MOCK_QUEUE:-}"

if [[ -z "$QUEUE_FILE" ]] || [[ ! -f "$QUEUE_FILE" ]]; then
  echo "gh mock: GH_MOCK_QUEUE not set or file missing: ${QUEUE_FILE:-unset}" >&2
  exit 1
fi

response=$(head -n 1 "$QUEUE_FILE")
tail -n +2 "$QUEUE_FILE" > "${QUEUE_FILE}.tmp" && mv "${QUEUE_FILE}.tmp" "$QUEUE_FILE"

stdout=$(echo "$response" | jq -r '.stdout // ""')
stderr=$(echo "$response" | jq -r '.stderr // ""')
exit_code=$(echo "$response" | jq -r '.exitCode // 0')

if [[ -n "$stdout" ]]; then
  printf '%s' "$stdout"
fi
if [[ -n "$stderr" ]]; then
  printf '%s' "$stderr" >&2
fi
exit "$exit_code"
